    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "histogram_quantile(0.9, sum by (le, cluster_queue)(rate(kueue_admitted_until_ready_wait_time_seconds_bucket[2m])))",
     "legendFormat": "{{cluster_queue}}"
