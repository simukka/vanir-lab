{
 "uid": "vanir-lab",
 "title": "vanir-lab: shared GPU pool",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "tags": [
  "kueue",
  "vanir-lab"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "GPU allocation (quota used / fleet)",
   "description": "Admitted GPU quota over total nominal quota. Allocation, not utilisation: an idle slurmd still counts.",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "100 * sum(kueue_cluster_queue_resource_usage{resource=\"nvidia.com/gpu\"}) / sum(kueue_cluster_queue_nominal_quota{resource=\"nvidia.com/gpu\"})",
     "legendFormat": "allocated"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Pending workloads",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(kueue_pending_workloads)",
     "legendFormat": "pending"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Borrowed GPUs",
   "description": "GPUs running on quota lent by other queues: the perishable part of the fleet.",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(clamp_min(sum by (cluster_queue)(kueue_cluster_queue_resource_usage{resource=\"nvidia.com/gpu\"}) - sum by (cluster_queue)(kueue_cluster_queue_nominal_quota{resource=\"nvidia.com/gpu\"}), 0))",
     "legendFormat": "borrowed"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Evictions (last 10m)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(increase(kueue_evicted_workloads_total[10m]))",
     "legendFormat": "evicted"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "GPUs in use by ClusterQueue",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (cluster_queue)(kueue_cluster_queue_resource_usage{resource=\"nvidia.com/gpu\"})",
     "legendFormat": "{{cluster_queue}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 30,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
