  {
   "id": 8,
   "type": "timeseries",
   "title": "Evictions per minute by victim queue / reason",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (cluster_queue, reason)(increase(kueue_evicted_workloads_total[1m]))",
     "legendFormat": "{{cluster_queue}} {{reason}}"
