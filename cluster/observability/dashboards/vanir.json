   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Inference: request queue vs replicas",
   "description": "Pushed by tools/queue-autoscaler.py, which scales like Verda serverless containers: on queue load = queue / replicas.",
   "datasource": {
